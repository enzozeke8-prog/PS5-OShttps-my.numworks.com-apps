+     "Suites numeriques", 0xE7A813},
+    {I18n::Message::RegressionApp, DsIcons::IconRegression, "Regressions",
+     "Ajuster un nuage de points", 0x1E78E0},
+    {I18n::Message::InferenceApp, DsIcons::IconInference, "Inference",
+     "Tests et intervalles", 0x4352C9},
+    {I18n::Message::FinanceApp, DsIcons::IconFinance, "Finance",
+     "Interets et emprunts", 0xC48A12},
+    {I18n::Message::CodeApp, DsIcons::IconCode, "Python",
+     "Programmer en Python", 0x2B5FB0},
+    {I18n::Message::ElementsApp, DsIcons::IconElements, "Elements",
+     "Tableau periodique", 0xD9312B},
+    {I18n::Message::SettingsApp, DsIcons::IconSettings, "Parametres",
+     "Reglages de la calculatrice", 0x8892A0},
+};
+constexpr int k_numberOfArts = sizeof(k_builtinArt) / sizeof(k_builtinArt[0]);
+
+// Colours given to the games (their icon has no colour name)
+constexpr uint32_t k_gameColors[] = {0xE0384A, 0x8A4DFF, 0x16B3C9,
+                                     0xF08A24, 0x37C16B, 0xE84FA0};
+
+constexpr int k_maxBuiltin = 20;
+int8_t s_builtin[k_maxBuiltin];     // app index in AppsContainer
+int8_t s_builtinArt[k_maxBuiltin];  // index in k_builtinArt, or -1
+const char* s_builtinLabel[k_maxBuiltin];
+int s_numberOfBuiltin = 0;
+int s_numberOfGames = 0;
+
+// Photo session (simulator only): fake list of apps, no AppsContainer
+bool s_photo = false;
+
+void listApps() {
+  if (s_photo) {
+    return;
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfBuiltin = 0;
+  for (int i = 1; i < builtin && s_numberOfBuiltin < k_maxBuiltin; i++) {
+    I18n::Message name = container->appSnapshotAtIndex(
+                             PermutedAppSnapshotIndex(i))
+                             ->descriptor()
+                             ->name();
+    int art = -1;
+    for (int a = 0; a < k_numberOfArts; a++) {
+      if (k_builtinArt[a].name == name) {
+        art = a;
+      }
+    }
+    s_builtin[s_numberOfBuiltin] = i;
+    s_builtinArt[s_numberOfBuiltin] = art;
+    s_builtinLabel[s_numberOfBuiltin] =
+        art >= 0 ? k_builtinArt[art].label : I18n::translate(name);
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfApps() - builtin;
+  if (s_numberOfGames < 0) {
+    s_numberOfGames = 0;
+  }
+}
+
+// Items are numbered globally: the calculator apps, then the games
+int numberOfItems() { return s_numberOfBuiltin + s_numberOfGames; }
+bool isGame(int g) { return g >= s_numberOfBuiltin; }
+
+const char* itemLabel(int g) {
+  if (!isGame(g)) {
+    return s_builtinLabel[g];
+  }
+  if (s_photo) {
+    return g == s_numberOfBuiltin ? "Mon jeu" : "Super jeu";
+  }
+  return AppsContainer::sharedAppsContainer()
+      ->externalAppAtIndex(g - s_numberOfBuiltin)
+      .name();
+}
+
+const char* itemDesc(int g) {
+  if (!isGame(g)) {
+    return s_builtinArt[g] >= 0 ? k_builtinArt[s_builtinArt[g]].desc
+                                : "Application";
+  }
+  return "Jeu installe (.nwa)";
+}
+
+uint32_t itemColor(int g) {
+  if (!isGame(g)) {
+    return s_builtinArt[g] >= 0 ? k_builtinArt[s_builtinArt[g]].color
+                                : 0x8892A0;
+  }
+  // a colour that depends on the name of the game
+  uint32_t h = 7;
+  for (const char* c = itemLabel(g); c && *c; c++) {
+    h = h * 31 + static_cast<uint8_t>(*c);
+  }
+  return k_gameColors[h % (sizeof(k_gameColors) / sizeof(k_gameColors[0]))];
+}
+
+int builtinIcon(int g) {
+  return s_builtinArt[g] >= 0 ? k_builtinArt[s_builtinArt[g]].icon
+                              : DsIcons::IconGame;
+}
+
+// Index of the calculator app called name, or -1
+int findBuiltin(I18n::Message name) {
+  for (int i = 0; i < s_numberOfBuiltin; i++) {
+    if (s_builtinArt[i] >= 0 && k_builtinArt[s_builtinArt[i]].name == name) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+/* --------------------------------------------------------------- state */
+
+enum Tab : uint8_t { TabGames = 0, TabApps = 1 };
+enum class Focus : uint8_t { Top, Row, Button, Cards };
+
+struct State {
+  int tab = TabApps;
+  int sel[2] = {0, 0};  // selection in each tab
+  float scroll = 0;     // row position, in tiles
+  Focus focus = Focus::Row;
+  int top = TopApps;
+  int card = 0;
+  int theme = 0;
+  int phase = 0;   // frames since start
+  int hero = 0;    // frames left of the hero sliding in
+  int pop = 0;     // frames left of the selection bounce
+  int appear = 0;  // frames left of the tiles sliding in
+  int intro = 0;   // frames left of the boot flare
+  bool profile = false;  // "who is playing?" screen
+  bool booted = false;
+  int toast = 0;  // frames left of the theme name
+  int panel = 0;  // profile panel: 0 closed .. k_panelFrames open
+  bool panelOpen = false;
+  int lastBattery = -1;
+  int launches = 0;
+  bool launching = false;
+  Rect zoom = {0, 0, 0, 0};
+  int zoomItem = -1;
+  int fade = 0;   // darkness over the splash screen, 0..256
+  int wipe = -1;  // x of the theme wipe, -1 when none
+};
+
+State s;
+Item s_launch = k_noItem;
+void (*s_invalidate)(Rect) = nullptr;
+void (*s_painter)(Rect) = nullptr;
+
+const Theme& theme() { return k_themes[s.theme]; }
+KDColor white() { return rgb(0xFFFFFF); }
+KDColor sub() { return rgb(theme().sub); }
+KDColor accent() { return rgb(theme().accent); }
+
+int tabCount(int tab) {
+  return tab == TabGames ? s_numberOfGames : s_numberOfBuiltin;
+}
+int tabCount() { return tabCount(s.tab); }
+// Global item of the i-th tile of the current tab
+int tabItem(int i) { return s.tab == TabGames ? s_numberOfBuiltin + i : i; }
+int selected() { return s.sel[s.tab]; }
+// Global selected item, or -1 when the tab is empty
+int current() { return tabCount() > 0 ? tabItem(selected()) : -1; }
+
+void invalidate(Rect r) {
+  if (s_invalidate) {
+    s_invalidate(r.intersection(k_screen));
+  }
+}
+
+void invalidateAll() { invalidate(k_screen); }
+
+// Draws right now (animations), or later when there is no painter
+void paint(Rect r) {
+  r = r.intersection(k_screen);
+  if (r.isEmpty()) {
+    return;
+  }
+  if (s_painter) {
+    s_painter(r);
+  } else {
+    invalidate(r);
+  }
+}
+
+float clamp01(float t) { return t < 0.f ? 0.f : (t > 1.f ? 1.f : t); }
+float easeOut(float t) {
+  t = 1.f - clamp01(t);
+  return 1.f - t * t * t;
+}
+
+Rect unite(Rect a, Rect b) {
+  if (a.isEmpty()) {
+    return b;
+  }
+  if (b.isEmpty()) {
+    return a;
+  }
+  int x = a.x < b.x ? a.x : b.x, y = a.y < b.y ? a.y : b.y;
+  int r = a.right() > b.right() ? a.right() : b.right();
+  int bt = a.bottom() > b.bottom() ? a.bottom() : b.bottom();
+  return {x, y, r - x, bt - y};
+}
+
+// Restricts drawing to r for the lifetime of the scope
+class Clip {
+ public:
+  Clip(Band& b, Rect r) : m_band(b), m_saved(b.clip()) {
+    m_ok = b.setClip(r.intersection(m_saved));
+  }
+  ~Clip() { m_band.setClip(m_saved); }
+  bool ok() const { return m_ok; }
+
+ private:
+  Band& m_band;
+  Rect m_saved;
+  bool m_ok;
+};
+
+// Small string helpers (no printf on the calculator)
+int appendText(char* buf, int i, const char* t) {
+  while (*t && i < 38) {
+    buf[i++] = *t++;
+  }
+  buf[i] = 0;
+  return i;
+}
+
+int appendInt(char* buf, int i, int v) {
+  char digits[8];
+  int n = 0;
+  do {
+    digits[n++] = '0' + v % 10;
+    v /= 10;
+  } while (v > 0 && n < 7);
+  while (n > 0 && i < 38) {
+    buf[i++] = digits[--n];
+  }
+  buf[i] = 0;
+  return i;
+}
+
+int batteryPercent() {
+  if (s_photo) {
+    return 82;
+  }
+  float v = Battery::voltage();
+  int p = static_cast<int>((v - 3.6f) * 100.f / (4.15f - 3.6f));
+  return p < 0 ? 0 : (p > 100 ? 100 : p);
+}
+
+uint32_t lerp24(uint32_t a, uint32_t b, int t256) {
+  int r = ((a >> 16) & 255) + ((((int)((b >> 16) & 255) - (int)((a >> 16) & 255)) * t256) >> 8);
+  int g = ((a >> 8) & 255) + ((((int)((b >> 8) & 255) - (int)((a >> 8) & 255)) * t256) >> 8);
+  int bl = (a & 255) + ((((int)(b & 255) - (int)(a & 255)) * t256) >> 8);
+  return (r << 16) | (g << 8) | bl;
+}
+
+/* ---------------------------------------------------------- background */
+
+/* Two ribbons of light cross the background. Their shape depends on the
+ * selected app: it is computed once per selection. */
+int16_t s_ribbon[2][k_screenWidth];
+int s_ribbonFor = -2;
+uint32_t s_glow = 0x2F6DF0;  // colour of the glow (app colour + accent)
+
+void prepareBackground() {
+  int g = current();
+  int key = g * 8 + s.theme;
+  if (key == s_ribbonFor) {
+    return;
+  }
+  s_ribbonFor = key;
+  uint32_t c = g >= 0 ? itemColor(g) : theme().accent;
+  s_glow = lerp24(c, theme().accent, 70);
+  float p = (g + 3) * 1.7f;
+  for (int x = 0; x < k_screenWidth; x++) {
+    float fx = static_cast<float>(x);
+    s_ribbon[0][x] = static_cast<int16_t>(
+        150.f + 34.f * sinf(fx * 0.017f + p) + 10.f * sinf(fx * 0.05f + p * 2.f));
+    s_ribbon[1][x] = static_cast<int16_t>(
+        176.f + 26.f * sinf(fx * 0.013f - p * 1.3f) +
+        8.f * sinf(fx * 0.041f + p));
+  }
+}
+
+void drawBackground(Band& b) {
+  const Rect& z = b.clip();
+  const Theme& t = theme();
+  int gr = (s_glow >> 16) & 255, gg = (s_glow >> 8) & 255, gb = s_glow & 255;
+  constexpr int k_r2 = 150 * 150;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    uint32_t base = lerp24(t.top, t.bottom, y * 256 / k_screenHeight);
+    int br = (base >> 16) & 255, bg = (base >> 8) & 255, bb = base & 255;
+    int dy = y - k_artY;
+    int dy2 = dy * dy * 5 / 4;  // a slightly flat glow
+    for (int x = z.x; x < z.right(); x++) {
+      int dx = x - k_artX;
+      int d2 = dx * dx + dy2;
+      int r = br, g = bg, bl = bb;
+      if (d2 < k_r2) {
+        int k = ((k_r2 - d2) >> 6) * 256 / (k_r2 >> 6);  // 0..256
+        k = (k * k) >> 9;                                // soft, max 128
+        r += (gr * k) >> 8;
+        g += (gg * k) >> 8;
+        bl += (gb * k) >> 8;
+      }
+      // ribbons of light
+      for (int i = 0; i < 2; i++) {
+        int d = y - s_ribbon[i][x];
+        if (d < 0) d = -d;
+        constexpr int k_w = 9;
+        if (d < k_w) {
+          int k = (k_w - d) * (i == 0 ? 7 : 5);
+          if (d == 0) k += 14;
+          r += ((gr + 255) * k) >> 9;
+          g += ((gg + 255) * k) >> 9;
+          bl += ((gb + 255) * k) >> 9;
+        }
+      }
+      r = r > 255 ? 255 : r;
+      g = g > 255 ? 255 : g;
+      bl = bl > 255 ? 255 : bl;
+      row[x] = KDColor::RGB24((r << 16) | (g << 8) | bl);
+    }
+  }
+}
+
+/* ----------------------------------------------------------- sparkles */
+
+constexpr int k_sparkles = 14;
+struct Sparkle {
+  int16_t x, y;
+  uint8_t size;   // 1..3
+  uint8_t speed;  // 1..3
+};
+Sparkle s_sparkles[k_sparkles];
+Rect s_sparkleRect[k_sparkles];
+bool s_sparklesReady = false;
+
+void initSparkles() {
+  uint32_t seed = 0x505u;
+  for (int i = 0; i < k_sparkles; i++) {
+    seed = seed * 1103515245u + 12345u;
+    s_sparkles[i].x = 120 + (seed >> 8) % 200;
+    seed = seed * 1103515245u + 12345u;
+    s_sparkles[i].y = (seed >> 8) % 240;
+    s_sparkles[i].size = 1 + i % 3;
+    s_sparkles[i].speed = 1 + (seed >> 20) % 3;
+  }
+  s_sparklesReady = true;
+}
+
+Rect sparkleRect(int i) {
+  const Sparkle& p = s_sparkles[i];
+  int span = 220;
+  int y = (p.y - s.phase * p.speed / 2) % span;
+  if (y < 0) {
+    y += span;
+  }
+  y += 22;
+  int x = p.x + static_cast<int>(roundf(4.f * sinf(s.phase * 0.04f + i)));
+  return {x - 5, y - 5, 11, 11};
+}
+
+void drawSparkles(Band& b) {
+  for (int i = 0; i < k_sparkles; i++) {
+    Rect r = sparkleRect(i);
+    if (!r.intersects(b.clip())) {
+      continue;
+    }
+    int cx = r.x + 5, cy = r.y + 5;
+    int sz = s_sparkles[i].size;
+    if (sz == 3) {
+      int tw = (s.phase / 3 + i) % 5;
+      tinted(b, DsIcons::IconStar, cx - 4, cy - 4, white(), tw == 0 ? 90 : 170);
+    } else {
+      disc(b, cx, cy, sz, white(), 60 + 40 * sz);
+    }
+  }
+}
+
+/* ------------------------------------------------------------- top bar */
+
+int tabX(int tab) {
+  return tab == TabGames
+             ? 12
+             : 12 + scaledTextWidth("Jeux", k_tabScale) + 16;
+}
+
+void drawAvatar(Band& b, int cx, int cy, int r) {
+  // An original little round robot with a visor
+  disc(b, cx, cy, r, rgb(lerp24(theme().accent, 0xFFFFFF, 60)));
+  disc(b, cx, cy + r / 6, r * 3 / 4, rgb(0x14182A));
+  int ew = r / 4 > 1 ? r / 4 : 1;
+  disc(b, cx - r / 3, cy + r / 6, ew, rgb(0x7FF3FF));
+  disc(b, cx + r / 3, cy + r / 6, ew, rgb(0x7FF3FF));
+  if (r >= 12) {
+    // antenna
+    fill(b, {cx - 1, cy - r - r / 3, 2, r / 3 + 1}, rgb(0xDDE3EE));
+    disc(b, cx, cy - r - r / 3, r / 6 + 1, accent());
+  }
+}
+
+void drawBattery(Band& b, int x, int y) {
+  int pct = batteryPercent();
+  char buf[8];
+  int i = appendInt(buf, 0, pct);
+  appendText(buf, i, "%");
+  text(b, buf, x, y, white(), KDFont::Size::Small, Align::Right);
+  if (!s_photo && Battery::isCharging()) {
+    int w = textWidth(buf);
+    tinted(b, DsIcons::IconBolt, x - w - 10, y + 3, accent());
+  }
+}
+
+Rect topItemRect(int item) {
+  if (item == TopGames || item == TopApps) {
+    int x = tabX(item);
+    const char* t = item == TopGames ? "Jeux" : "Applis";
+    return {x - 5, 2, scaledTextWidth(t, k_tabScale) + 10, 19};
+  }
+  return {k_topIconX[item] - 3, 2, 19, 19};
+}
+
+void drawTopBar(Band& b) {
+  if (!k_topBar.intersects(b.clip())) {
+    return;
+  }
+  for (int tab = 0; tab < 2; tab++) {
+    bool active = s.tab == tab;
+    KDColor c = active ? white() : sub();
+    scaledText(b, tab == TabGames ? "Jeux" : "Applis", tabX(tab), k_tabY, c,
+               k_tabScale);
+  }
+  tinted(b, DsIcons::IconTopTheme, k_topIconX[TopTheme], 5, white(), 220);
+  tinted(b, DsIcons::IconTopSettings, k_topIconX[TopSettings], 5, white(),
+         220);
+  drawAvatar(b, k_topIconX[TopProfile] + 6, 11, 7);
+  drawBattery(b, 316, 4);
+  if (s.focus == Focus::Top) {
+    Rect r = topItemRect(s.top);
+    int a = 150 + static_cast<int>(70.f * sinf(s.phase * 0.25f));
+    roundFrame(b, r, 6, white(), a);
+    roundFill(b, r, 6, white(), 34);
+  }
+}
+
+/* ---------------------------------------------------------------- tiles */
+
+void drawItemIcon(Band& b, int g, int x, int y, int size) {
+  if (g < 0) {
+    return;
+  }
+  if (!isGame(g)) {
+    int icon = builtinIcon(g);
+    if (size == k_bigTile) {
+      image(b, icon, x, y);
+    } else if (size == k_smallTile) {
+      image(b, icon + DsIcons::k_smallOffset, x, y);
+    } else {
+      image(b, size > k_smallTile ? icon : icon + DsIcons::k_smallOffset, x, y,
+            size);
+    }
+    return;
+  }
+  if (s_photo) {
+    image(b, DsIcons::IconGame, x, y, size);
+    return;
+  }
+  gameIcon(b,
+           AppsContainer::sharedAppsContainer()->externalAppAtIndex(
+               g - s_numberOfBuiltin),
+           x, y, size);
+}
+
+// Where tile i of the row is, rel = i - scroll tiles after the selection
+Rect rowTile(int i) {
+  float rel = i - s.scroll;
+  float size, x;
+  if (rel >= 0.f && rel <= 1.f) {
+    size = k_bigTile + (k_smallTile - k_bigTile) * rel;
+    x = k_rowX + rel * (k_bigTile + 8);
+  } else if (rel > 1.f) {
+    size = k_smallTile;
+    x = k_rowX + k_bigTile + 8 + (rel - 1.f) * k_smallStep;
+  } else {
+    float k = rel < -1.f ? 1.f : -rel;
+    size = k_bigTile + (k_smallTile - k_bigTile) * k;
+    x = k_rowX + rel * (k_smallTile + 18);
+  }
+  int sz = static_cast<int>(roundf(size));
+  int xi = static_cast<int>(roundf(x));
+  // the tiles slide in from the right, one after the other
+  if (s.appear > 0) {
+    int order = static_cast<int>(rel < 0 ? 0 : rel);
+    float t = 1.f - (s.appear - order * 1.2f) / k_appearFrames;
+    xi += static_cast<int>((1.f - easeOut(t)) * 180.f);
+  }
+  return {xi, k_rowY + (k_bigTile - sz) / 2, sz, sz};
+}
+
+void drawRow(Band& b) {
+  if (!k_rowArea.intersects(b.clip())) {
+    return;
+  }
+  int n = tabCount();
+  if (n == 0) {
+    // empty Games tab: a dashed slot
+    Rect r = {k_rowX, k_rowY, k_bigTile, k_bigTile};
+    roundFill(b, r, 6, white(), 26);
+    for (int k = 0; k < k_bigTile; k += 6) {
+      fill(b, {r.x + k, r.y, 3, 1}, white(), 140);
+      fill(b, {r.x + k, r.bottom() - 1, 3, 1}, white(), 140);
+      fill(b, {r.x, r.y + k, 1, 3}, white(), 140);
+      fill(b, {r.right() - 1, r.y + k, 1, 3}, white(), 140);
+    }
+    fill(b, {r.x + 22, r.y + 14, 2, 18}, white(), 200);
+    fill(b, {r.x + 14, r.y + 22, 18, 2}, white(), 200);
+    text(b, "Aucun jeu", k_rowX, k_labelY, white());
+    return;
+  }
+  int first = static_cast<int>(s.scroll) - 2;
+  for (int i = first < 0 ? 0 : first; i < n; i++) {
+    Rect r = rowTile(i);
+    if (r.x >= k_screenWidth) {
+      break;
+    }
+    if (r.right() <= 0) {
+      continue;
+    }
+    if (i == selected() && s.focus == Focus::Row && s.pop > 0) {
+      int d = s.pop > 4 ? 8 - s.pop : s.pop;  // 0..4..0 frames
+      r = r.inset(-d / 2);
+    }
+    if (r.w > k_smallTile + 2) {
+      roundFill(b, r.translated(0, 3), 8, rgb(0x000000), 70);
+    }
+    drawItemIcon(b, tabItem(i), r.x, r.y, r.w);
+  }
+  // selection frame and name
+  Rect r = rowTile(selected());
+  if (s.focus == Focus::Row) {
+    Rect f = r.inset(-3);
+    int a = 180 + static_cast<int>(70.f * sinf(s.phase * 0.22f));
+    roundFrame(b, f, 9, white(), a);
+    roundFrame(b, f.inset(1), 8, white(), a);
+  }
+  if (s.appear < k_appearFrames / 2) {
+    text(b, itemLabel(tabItem(selected())), k_rowX, k_labelY, white(),
+         KDFont::Size::Small, Align::Left, 300);
+  }
+}
+
+/* ----------------------------------------------------------------- hero */
+
+float heroProgress() {
+  return easeOut(1.f - s.hero / static_cast<float>(k_heroFrames));
+}
+
+void drawKeyArt(Band& b) {
+  if (!k_artArea.intersects(b.clip())) {
+    return;
+  }
+  int g = current();
+  float t = heroProgress();
+  int bob = static_cast<int>(roundf(3.f * sinf(s.phase * 0.08f)));
+  // orbit and its lights
+  ring(b, k_artX, k_artY, 58, 1.2f, 1.f, white(), 40);
+  ring(b, k_artX, k_artY, 46, 1.f, 1.f, white(), 22);
+  for (int i = 0; i < 3; i++) {
+    float a = s.phase * 0.045f + i * 2.094f;
+    int r = i == 0 ? 3 : 2;
+    float rad = i == 1 ? 46.f : 58.f;
+    disc(b, k_artX + static_cast<int>(rad * cosf(a)),
+         k_artY + static_cast<int>(rad * sinf(a)), r, white(), 220);
+  }
+  if (g < 0) {
+    tinted(b, DsIcons::IconGameArt, k_artX - 38, k_artY - 38 + bob, white(),
+           90);
+    return;
+  }
+  int alpha = static_cast<int>(256 * clamp01(t * 1.4f));
+  int dy = static_cast<int>((1.f - t) * 14.f);
+  if (isGame(g)) {
+    Rect f = {k_artX - 32, k_artY - 32 + bob + dy, 64, 64};
+    roundFill(b, f.translated(0, 4), 12, rgb(0x000000), 90);
+    drawItemIcon(b, g, f.x, f.y, 64);
+    return;
+  }
+  image(b, builtinIcon(g) + DsIcons::k_artOffset, k_artX - 38,
+        k_artY - 38 + bob + dy, 0, alpha);
+}
+
+void drawHero(Band& b) {
+  if (!k_heroArea.intersects(b.clip())) {
+    return;
+  }
+  int g = current();
+  float t = heroProgress();
+  int dx = static_cast<int>(roundf((1.f - t) * 24.f));
+  const char* title = g >= 0 ? itemLabel(g) : "Jeux";
+  const char* desc = g >= 0 ? itemDesc(g) : "Installe des jeux .nwa avec PS5-OS";
+  scaledText(b, title, 14 + dx, k_titleY, white(), k_titleScale);
+  text(b, desc, 14 + dx * 2, k_descY, sub(), KDFont::Size::Small, Align::Left,
+       180);
+  // the Open button
+  Rect r = k_openButton.translated(dx * 3, 0);
+  bool focused = s.focus == Focus::Button;
+  if (focused) {
+    int a = 230 + static_cast<int>(26.f * sinf(s.phase * 0.25f));
+    roundFill(b, r.inset(-2), 13, white(), 70);
+    roundFill(b, r, 11, white(), a > 256 ? 256 : a);
+  } else {
+    roundFill(b, r, 11, white(), 46);
+    roundFrame(b, r, 11, white(), 90);
+  }
+  text(b, g >= 0 ? "Ouvrir" : "Aucun jeu", r.x + r.w / 2, r.y + 4,
+       focused ? rgb(0x10131C) : white(), KDFont::Size::Small, Align::Center);
+}
+
+/* ---------------------------------------------------------------- cards */
+
+// Global item shown on card c: the apps that follow the selection
+int cardItem(int c) {
+  int n = numberOfItems();
+  if (n < 2) {
+    return -1;
+  }
+  int g = current();
+  int start = g < 0 ? -1 : g;
+  int k = start;
+  for (int i = 0; i <= c; i++) {
+    k = (k + 1) % n;
+    if (k == start) {
+      k = (k + 1) % n;
+    }
+  }
+  return k;
+}
+
+int numberOfCards() {
+  int n = numberOfItems() - (current() >= 0 ? 1 : 0);
+  return n < k_maxCards ? (n < 0 ? 0 : n) : k_maxCards;
+}
+
+Rect cardRect(int c) {
+  int x = 14 + c * k_cardStep;
+  if (s.appear > 0) {
+    float t = 1.f - (s.appear - c * 1.5f - 2) / k_appearFrames;
+    x += static_cast<int>((1.f - easeOut(t)) * 200.f);
+  }
+  return {x, k_cardY, k_cardW, k_cardH};
+}
+
+void drawCards(Band& b) {
+  if (!k_cardsArea.intersects(b.clip())) {
+    return;
+  }
+  int n = numberOfCards();
+  if (n == 0) {
+    return;
+  }
+  text(b, "A decouvrir", 14, k_cardsLabelY, white());
+  for (int c = 0; c < n; c++) {
+    Rect r = cardRect(c);
+    if (!r.inset(-3).intersects(b.clip())) {
+      continue;
+    }
+    int g = cardItem(c);
+    uint32_t col = itemColor(g);
+    {
+      Clip clip(b, r);
+      if (clip.ok()) {
+        // banner: the app colour, darker at the bottom, its symbol big
+        vgradient(b, r, rgb(lerp24(col, 0xFFFFFF, 40)),
+                  rgb(lerp24(col, 0x000000, 120)));
+        if (isGame(g)) {
+          drawItemIcon(b, g, r.right() - 30, r.y + 2, 26);
+        } else {
+          tinted(b, builtinIcon(g) + DsIcons::k_artOffset, r.right() - 44,
+                 r.y - 22, white(), 70);
+        }
+        text(b, itemLabel(g), r.x + 5, r.y + 8, white(), KDFont::Size::Small,
+             Align::Left, r.w - 8);
+      }
+    }
+    // rounded corners: paint the background back in the corners
+    roundFrame(b, r.inset(-1), 5, rgb(theme().bottom), 120);
+    if (s.focus == Focus::Cards && c == s.card) {
+      int a = 180 + static_cast<int>(70.f * sinf(s.phase * 0.22f));
+      roundFrame(b, r.inset(-3), 6, white(), a);
+      roundFrame(b, r.inset(-2), 5, white(), a);
+    }
+  }
+}
+
+/* ------------------------------------------------------------- overlays */
+
+void drawToast(Band& b) {
+  if (s.toast <= 0 || !k_toastArea.intersects(b.clip())) {
+    return;
+  }
+  roundFill(b, k_toastArea, 8, rgb(0x000000), 150);
+  char buf[40];
+  int i = appendText(buf, 0, "Theme : ");
+  appendText(buf, i, theme().name);
+  text(b, buf, k_toastArea.x + k_toastArea.w / 2, k_toastArea.y + 1, white(),
+       KDFont::Size::Small, Align::Center);
+}
+
+void drawPanel(Band& b) {
+  if (s.panel <= 0) {
+    return;
+  }
+  float t = easeOut(s.panel / static_cast<float>(k_panelFrames));
+  dim(b, static_cast<int>(150 * t));
+  int dy = static_cast<int>((1.f - t) * 30.f);
+  Rect p = k_panel.translated(0, dy);
+  if (!p.intersects(b.clip())) {
+    return;
+  }
+  roundFill(b, p, 12, rgb(0x161B2B), static_cast<int>(245 * t));
+  roundFrame(b, p, 12, accent(), static_cast<int>(200 * t));
+  drawAvatar(b, p.x + p.w / 2, p.y + 40, 20);
+  text(b, "Joueur 1", p.x + p.w / 2, p.y + 68, white(), KDFont::Size::Large,
+       Align::Center);
+  text(b, "En ligne sur ta NumWorks", p.x + p.w / 2, p.y + 88, sub(),
+       KDFont::Size::Small, Align::Center);
+  fill(b, {p.x + 20, p.y + 106, p.w - 40, 1}, white(), 50);
+  const char* labels[4] = {"Applis", "Jeux", "Lancements", "Batterie"};
+  int values[4] = {s_numberOfBuiltin, s_numberOfGames, s.launches,
+                   batteryPercent()};
+  for (int i = 0; i < 4; i++) {
+    int y = p.y + 112 + i * 16;
+    text(b, labels[i], p.x + 24, y, sub());
+    char buf[12];
+    int k = appendInt(buf, 0, values[i]);
+    if (i == 3) {
+      appendText(buf, k, " %");
+    }
+    text(b, buf, p.right() - 24, y, white(), KDFont::Size::Small, Align::Right);
+  }
+}
+
+void drawIntro(Band& b) {
+  float t = 1.f - s.intro / static_cast<float>(k_introFrames);
+  fill(b, k_screen, rgb(0x000000));
+  // a ray of light opens in the middle
+  float open = easeOut(t / 0.4f);
+  int half = static_cast<int>(160.f * open);
+  int fadeOut = t > 0.8f ? static_cast<int>(256.f * (1.f - (t - 0.8f) / 0.2f)) : 256;
+  if (half > 0) {
+    for (int d = 0; d < 10; d++) {
+      int a = (d == 0 ? 255 : 150 - d * 14) * fadeOut / 256;
+      KDColor c = d < 2 ? white() : rgb(0x2F6DF0);
+      fill(b, {160 - half, 120 - d, 2 * half, 1}, c, a);
+      if (d > 0) {
+        fill(b, {160 - half, 120 + d, 2 * half, 1}, c, a);
+      }
+    }
+  }
+  // the light gathers into the name
+  if (t > 0.3f) {
+    int a = static_cast<int>(256.f * clamp01((t - 0.3f) / 0.25f)) * fadeOut / 256;
+    KDColor c = KDColor::Blend(white(), rgb(0x000000),
+                               static_cast<uint8_t>(a > 255 ? 255 : a));
+    scaledText(b, "PS5-OS", 160, 82, c, 150, Align::Center);
+    KDColor g = KDColor::Blend(rgb(0x9AA8C8), rgb(0x000000),
+                               static_cast<uint8_t>(a > 255 ? 255 : a));
+    text(b, "pour NumWorks", 160, 140, g, KDFont::Size::Small, Align::Center);
+  }
+}
+
+void drawProfileScreen(Band& b) {
+  scaledText(b, "Qui joue ?", 160, 36, white(), 90, Align::Center);
+  int pulse = static_cast<int>(3.f * sinf(s.phase * 0.15f));
+  ring(b, 160, 116, 40 + pulse, 2.f, 1.f, accent(), 200);
+  ring(b, 160, 116, 46 + pulse, 1.f, 1.f, accent(), 80);
+  drawAvatar(b, 160, 120, 28);
+  text(b, "Joueur 1", 160, 166, white(), KDFont::Size::Large, Align::Center);
+  if ((s.phase / 10) % 2 == 0) {
+    text(b, "Appuie sur OK", 160, 206, sub(), KDFont::Size::Small,
+         Align::Center);
+  }
+}
+
+void drawZoom(Band& b) {
+  Rect z = s.zoom;
+  if (!z.intersects(b.clip())) {
+    return;
+  }
+  uint32_t col = s.zoomItem >= 0 ? itemColor(s.zoomItem) : theme().accent;
+  {
+    Clip c(b, z);
+    if (c.ok()) {
+      vgradient(b, z, rgb(lerp24(col, 0x000000, 60)),
+                rgb(lerp24(col, 0x000000, 200)));
+    }
+  }
+  int cx = z.x + z.w / 2, cy = z.y + z.h / 2;
+  if (s.zoomItem >= 0) {
+    if (z.w > 140) {
+      if (isGame(s.zoomItem)) {
+        drawItemIcon(b, s.zoomItem, cx - 32, cy - 50, 64);
+      } else {
+        image(b, builtinIcon(s.zoomItem) + DsIcons::k_artOffset, cx - 38,
+              cy - 56);
+      }
+      text(b, itemLabel(s.zoomItem), cx, cy + 32, white(), KDFont::Size::Large,
+           Align::Center);
+      ring(b, cx, cy + 74, 7, 2.f, 0.3f + 0.6f * ((s.phase % 10) / 10.f),
+           white(), 200);
+    } else {
+      drawItemIcon(b, s.zoomItem, cx - 15, cy - 15, k_smallTile);
+    }
+  }
+  if (s.fade > 0) {
+    Clip c(b, z);
+    if (c.ok()) {
+      dim(b, s.fade);
+    }
+  }
+}
+
+void drawWipe(Band& b) {
+  if (s.wipe < 0) {
+    return;
+  }
+  Rect bar = {s.wipe - 6, 0, 8, k_screenHeight};
+  if (!bar.intersects(b.clip())) {
+    return;
+  }
+  for (int i = 0; i < 8; i++) {
+    fill(b, {bar.x + i, 0, 1, k_screenHeight}, white(), 30 + i * 28);
+  }
+}
+
+/* ------------------------------------------------------------- actions */
+
+void waitUntil(uint32_t target) {
+  while (static_cast<uint32_t>(Ion::Timing::millis()) < target) {
+    Ion::Timing::msleep(1);
+  }
+}
+
+// The tile grows into a splash screen of the app, which then goes dark
+void zoomOpen(Rect from, int g) {
+  s.zoomItem = g;
+  if (!s_painter) {
+    return;
+  }
+  s.launching = true;
+  s.fade = 0;
+  constexpr int k_steps = 9;
+  uint32_t start = Ion::Timing::millis();
+  for (int i = 1; i <= k_steps; i++) {
+    float t = easeOut(i / static_cast<float>(k_steps));
+    Rect r = {from.x + static_cast<int>((k_screen.x - from.x) * t),
+              from.y + static_cast<int>((k_screen.y - from.y) * t),
+              from.w + static_cast<int>((k_screen.w - from.w) * t),
+              from.h + static_cast<int>((k_screen.h - from.h) * t)};
+    Rect old = s.zoom;
+    s.zoom = r;
+    paint(unite(old, r).inset(-1));
+    waitUntil(start + i * 22);
+  }
+  // the splash stays a moment, its spinner turning, then fades to black
+  for (int i = 0; i < 8; i++) {
+    s.phase++;
+    paint({110, 180, 100, 30});
+    waitUntil(Ion::Timing::millis() + 40);
+  }
+  for (int i = 1; i <= 6; i++) {
+    s.fade = i * 256 / 6;
+    paint(k_screen);
+    waitUntil(Ion::Timing::millis() + 20);
+  }
+}
+
+void launchItem(int g, Rect from) {
+  if (g < 0 || g >= numberOfItems()) {
+    return;
+  }
+  s.launches++;
+  zoomOpen(from, g);
+  if (!isGame(g)) {
+    s_launch = {Item::Kind::Builtin, s_builtin[g]};
+  } else {
+    s_launch = {Item::Kind::External,
+                static_cast<int16_t>(g - s_numberOfBuiltin)};
+  }
+}
+
+void setTheme(int next) {
+  next = (next + k_numberOfThemes) % k_numberOfThemes;
+  s.toast = k_toastFrames;
+  s.theme = next;
+  prepareBackground();
+  if (!s_painter) {
+    invalidateAll();
+    return;
+  }
+  // The new colours sweep from left to right behind a bar of light
+  int prev = 0;
+  constexpr int k_steps = 12;
+  uint32_t start = Ion::Timing::millis();
+  for (int i = 1; i <= k_steps; i++) {
+    int x = static_cast<int>(k_screenWidth *
+                             easeOut(i / static_cast<float>(k_steps)));
+    s.wipe = i < k_steps ? x : -1;
+    paint({prev - 8, 0, x - prev + 10, k_screenHeight});
+    prev = x;
+    waitUntil(start + i * 20);
+  }
+  s.wipe = -1;
+  invalidateAll();
+}
+
+void heroChanged() {
+  s.hero = k_heroFrames;
+  prepareBackground();
+  invalidateAll();
+}
+
+void select(int index) {
+  int n = tabCount();
+  if (n == 0) {
+    return;
+  }
+  index = index < 0 ? 0 : (index >= n ? n - 1 : index);
+  if (index == selected()) {
+    return;
+  }
+  s.sel[s.tab] = index;
+  s.pop = 8;
+  heroChanged();
+}
+
+void setTab(int tab) {
+  if (tab == s.tab) {
+    return;
+  }
+  s.tab = tab;
+  s.scroll = static_cast<float>(selected());
+  s.appear = k_appearFrames;
+  s.card = 0;
+  heroChanged();
+}
+
+void setFocus(Focus f) {
+  s.focus = f;
+  if (f == Focus::Top) {
+    s.top = s.tab;
+  }
+  if (f == Focus::Cards && s.card >= numberOfCards()) {
+    s.card = 0;
+  }
+  invalidateAll();
+}
+
+void openPanel(bool open) { s.panelOpen = open; }
+
+void enterHome() {
+  s.profile = false;
+  s.appear = k_appearFrames + 4;
+  s.hero = k_heroFrames;
+  s.focus = Focus::Row;
+  prepareBackground();
+  invalidateAll();
+}
+
+void doTopItem(int item) {
+  switch (item) {
+    case TopGames:
+    case TopApps:
+      setTab(item);
+      setFocus(Focus::Row);
+      break;
+    case TopTheme:
+      setTheme(s.theme + 1);
+      break;
+    case TopSettings:
+      launchItem(findBuiltin(I18n::Message::SettingsApp),
+                 topItemRect(TopSettings));
+      break;
+    default:
+      openPanel(true);
+      break;
+  }
+}
