+  {76, 76, k_InferenceArtColors, k_InferenceArtAlphas},
+  {76, 76, k_FinanceArtColors, k_FinanceArtAlphas},
+  {76, 76, k_CodeArtColors, k_CodeArtAlphas},
+  {76, 76, k_ElementsArtColors, k_ElementsArtAlphas},
+  {76, 76, k_SettingsArtColors, k_SettingsArtAlphas},
+  {76, 76, k_GameArtColors, k_GameArtAlphas},
+  {13, 13, k_TopSettingsColors, k_TopSettingsAlphas},
+  {13, 13, k_TopThemeColors, k_TopThemeAlphas},
+  {13, 13, k_TopSearchColors, k_TopSearchAlphas},
