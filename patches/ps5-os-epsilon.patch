+
+void enter() {
+  listApps();
+  if (!s_sparklesReady) {
+    initSparkles();
+  }
+  for (int tab = 0; tab < 2; tab++) {
+    int n = tabCount(tab);
+    if (s.sel[tab] >= n) {
+      s.sel[tab] = n > 0 ? n - 1 : 0;
+    }
+  }
+  s.launching = false;
+  s.zoomItem = -1;
+  s.fade = 0;
+  s.wipe = -1;
+  s.panel = 0;
+  s.panelOpen = false;
+  s_launch = k_noItem;
+  if (!s.booted) {
+    s.booted = true;
+    s.tab = s_numberOfGames > 0 ? TabGames : TabApps;
+    s.intro = k_introFrames;
+    s.profile = true;
+  } else {
+    // back from an app: the tiles slide in again
+    s.appear = k_appearFrames;
+    s.hero = k_heroFrames;
+  }
+  s.scroll = static_cast<float>(selected());
+  s_ribbonFor = -2;
+  prepareBackground();
+#if !PLATFORM_DEVICE
+  static bool s_photoDone = false;
+  if (!s_photoDone && getenv("DS_SHOTS")) {
+    s_photoDone = true;
+    photoSession();
+    listApps();
+    s_ribbonFor = -2;
+    prepareBackground();
+  }
+#endif
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+void launchFailed() {
+  s.launching = false;
+  s.fade = 0;
+  invalidateAll();
+}
+
+bool handleEvent(Event e) {
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (s.intro > 0) {
+    // any key skips the flare
+    s.intro = 0;
+    invalidateAll();
+    return true;
+  }
+  if (s.profile) {
+    if (e == Events::OK || e == Events::EXE || e == Events::Home) {
+      enterHome();
+    }
+    return true;
+  }
+  if (s.panelOpen) {
+    openPanel(false);
+    return true;
+  }
+  bool ok = e == Events::OK || e == Events::EXE;
+
+  switch (s.focus) {
+    case Focus::Top:
+      if (e == Events::Left || e == Events::Right) {
+        int t = s.top + (e == Events::Right ? 1 : -1);
+        if (t >= 0 && t < NumberOfTopItems) {
+          invalidate(k_topBar);
+          s.top = t;
+        }
+        return true;
+      }
+      if (e == Events::Down || e == Events::Back || e == Events::Home) {
+        setFocus(Focus::Row);
+        return true;
+      }
+      if (ok) {
+        doTopItem(s.top);
+        return true;
+      }
+      if (e == Events::Up) {
+        return true;
+      }
+      break;
+    case Focus::Row:
+      if (e == Events::Left || e == Events::Right) {
+        select(selected() + (e == Events::Right ? 1 : -1));
+        return true;
+      }
+      if (e == Events::Up) {
+        setFocus(Focus::Top);
+        return true;
+      }
+      if (e == Events::Down) {
+        setFocus(Focus::Button);
+        return true;
+      }
+      if (e == Events::Home || e == Events::Back) {
+        select(0);
+        return true;
+      }
+      if (ok) {
+        launchItem(current(), rowTile(selected()));
+        return true;
+      }
+      break;
+    case Focus::Button:
+      if (e == Events::Up || e == Events::Back || e == Events::Home) {
+        setFocus(Focus::Row);
+        return true;
+      }
+      if (e == Events::Down) {
+        if (numberOfCards() > 0) {
+          setFocus(Focus::Cards);
+        }
+        return true;
+      }
+      if (ok) {
+        launchItem(current(), k_openButton);
+        return true;
+      }
+      if (e == Events::Left || e == Events::Right) {
+        return true;
+      }
+      break;
+    case Focus::Cards:
+      if (e == Events::Left || e == Events::Right) {
+        int c = s.card + (e == Events::Right ? 1 : -1);
+        if (c >= 0 && c < numberOfCards()) {
+          invalidate(k_cardsArea);
+          s.card = c;
+        }
+        return true;
+      }
+      if (e == Events::Up) {
+        setFocus(Focus::Button);
+        return true;
+      }
+      if (e == Events::Back || e == Events::Home) {
+        setFocus(Focus::Row);
+        return true;
+      }
+      if (e == Events::Down) {
+        return true;
+      }
+      if (ok) {
+        launchItem(cardItem(s.card), cardRect(s.card));
+        return true;
+      }
+      break;
+  }
+  // Shortcuts: Outils switches tab, Var changes the theme
+  if (e == Events::Toolbox) {
+    setTab(s.tab == TabGames ? TabApps : TabGames);
+    return true;
+  }
+  if (e == Events::Var) {
+    setTheme(s.theme + 1);
+    return true;
+  }
+  // Keys 1 to 9 select a tile, 0 the settings, like on the official home
+  const char* t = e.text();
+  if (t && t[0] >= '0' && t[0] <= '9' && t[1] == 0) {
+    int index;
+    if (t[0] == '0') {
+      setTab(TabApps);
+      index = s_numberOfBuiltin - 1;
+    } else {
+      index = t[0] - '1';
+    }
+    if (index < tabCount()) {
+      if (s.focus != Focus::Row) {
+        setFocus(Focus::Row);
+      }
+      if (index == selected()) {
+        return handleEvent(Events::OK);
+      }
+      select(index);
+    }
+    return true;
+  }
+  return false;
+}
+
+bool tick() {
+  int battery = batteryPercent();
+  if (battery != s.lastBattery) {
+    s.lastBattery = battery;
+    invalidate({270, 0, 50, 20});
+  }
+  return false;
+}
+
+int framePeriod() { return k_framePeriod; }
+
+bool frame() {
+  s.phase++;
+  if (s.launching) {
+    return false;
+  }
+  if (s.intro > 0) {
+    s.intro--;
+    paint(k_screen);
+    return false;
+  }
+  if (s.profile) {
+    if (s.phase % 2 == 0) {
+      paint({100, 60, 120, 120});
+    }
+    if (s.phase % 10 == 0) {
+      paint({100, 204, 120, 18});
+    }
+    return false;
+  }
+  if (s.panelOpen && s.panel < k_panelFrames) {
+    s.panel++;
+    paint(k_screen);
+    return false;
+  }
+  if (!s.panelOpen && s.panel > 0) {
+    s.panel--;
+    paint(k_screen);
+    return false;
+  }
+  if (s.panel > 0) {
+    return false;
+  }
+  // The row glides towards the selection
+  bool moved = false;
+  float target = static_cast<float>(selected());
+  if (fabsf(target - s.scroll) > 0.002f) {
+    s.scroll += (target - s.scroll) * 0.38f;
+    if (fabsf(target - s.scroll) < 0.01f) {
+      s.scroll = target;
+    }
+    moved = true;
+  }
+  if (s.appear > 0) {
+    s.appear--;
+    moved = true;
+    paint(k_cardsArea);
+  }
+  if (moved) {
+    paint(k_rowArea);
+  } else if (s.focus == Focus::Row && (s.pop > 0 || s.phase % 2 == 0)) {
+    // the frame of the selection pulses
+    paint(rowTile(selected()).inset(-5));
+  }
+  if (s.pop > 0) {
+    s.pop--;
+  }
+  // Hero sliding in, key art floating with its lights
+  if (s.hero > 0) {
+    s.hero--;
+    paint(k_heroArea);
+    paint(k_artArea);
+  } else if (s.phase % 2 == 0) {
+    paint(k_artArea);
+  }
+  if (s.phase % 2 == 0) {
+    if (s.focus == Focus::Button) {
+      paint(k_openButton.inset(-3));
+    } else if (s.focus == Focus::Cards) {
+      paint(cardRect(s.card).inset(-4));
+    } else if (s.focus == Focus::Top) {
+      paint(topItemRect(s.top).inset(-1));
+    }
+  }
+  if (s.toast > 0) {
+    s.toast--;
+    if (s.toast == 0) {
+      paint(k_toastArea);
+    }
+  }
+  // Sparkles drift up
+  if (s.phase % 2 == 0) {
+    for (int i = 0; i < k_sparkles; i++) {
+      Rect r = sparkleRect(i);
+      if (r.x != s_sparkleRect[i].x || r.y != s_sparkleRect[i].y) {
+        Rect u = unite(r, s_sparkleRect[i]);
+        if (!u.intersects(k_artArea) || s.hero > 0) {
+          paint(u);
+        }
+        s_sparkleRect[i] = r;
+      }
+    }
+  }
+  return false;
+}
+
+void render(Band& b) {
+  if (s.intro > 0) {
+    drawIntro(b);
+    return;
+  }
+  drawBackground(b);
+  drawSparkles(b);
+  if (s.profile) {
+    drawProfileScreen(b);
+    return;
+  }
+  drawKeyArt(b);
+  drawTopBar(b);
+  drawRow(b);
+  drawHero(b);
+  drawCards(b);
+  drawToast(b);
+  drawPanel(b);
+  if (s.launching) {
+    drawZoom(b);
+  }
+  drawWipe(b);
+}
+
+/* ------------------------------------------------- photos (simulator) */
+
+#if !PLATFORM_DEVICE
+
+namespace {
+
+uint16_t s_shot[k_screenWidth * k_screenHeight];
+int s_gifFrame = 0;
+
+void shoot(const char* name) {
+  Band band;
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+    band.begin(area);
+    render(band);
+    for (int j = 0; j < Band::k_maxHeight; j++) {
+      const KDColor* row = band.pixels() + j * k_screenWidth;
+      for (int i = 0; i < k_screenWidth; i++) {
+        s_shot[(y + j) * k_screenWidth + i] = static_cast<uint16_t>(row[i]);
+      }
+    }
+  }
+  char path[512];
+  snprintf(path, sizeof(path), "%s/%s.raw", getenv("DS_SHOTS"), name);
+  FILE* f = fopen(path, "wb");
+  if (f) {
+    fwrite(s_shot, 2, k_screenWidth * k_screenHeight, f);
+    fclose(f);
+  }
+}
+
+void wait(int frames, const char* gif = nullptr) {
+  for (int i = 0; i < frames; i++) {
+    frame();
+    if (gif) {
+      char name[64];
+      snprintf(name, sizeof(name), "%s_%04d", gif, s_gifFrame++);
+      shoot(name);
+    }
+  }
+}
+
+void key(Event e, int frames, const char* gif = nullptr) {
+  handleEvent(e);
+  takeLaunch();
+  s.launching = false;
+  wait(frames, gif);
+}
+
+// The launch splash, frame by frame (there is no painter here)
+void zoomShots(const char* gif) {
+  Rect from = rowTile(selected());
+  s.zoomItem = current();
+  s.launching = true;
+  s.fade = 0;
+  for (int i = 1; i <= 9; i++) {
+    float t = easeOut(i / 9.f);
+    s.zoom = {from.x + static_cast<int>((k_screen.x - from.x) * t),
+              from.y + static_cast<int>((k_screen.y - from.y) * t),
+              from.w + static_cast<int>((k_screen.w - from.w) * t),
+              from.h + static_cast<int>((k_screen.h - from.h) * t)};
+    wait(1, gif);
+  }
+  for (int i = 0; i < 8; i++) {
+    s.phase++;
+    wait(1, gif);
+  }
+  for (int i = 1; i <= 6; i++) {
+    s.fade = i * 256 / 6;
+    wait(1, gif);
+  }
+  s.launching = false;
+  s.fade = 0;
+}
+
+void fresh() {
+  s = State();
+  s.booted = true;
+  s_ribbonFor = -2;
+  prepareBackground();
+}
+
+}  // namespace
+
+void photoSession() {
+  // Same apps as on the calculator, plus two games
+  s_photo = true;
+  auto savedPainter = s_painter;
+  auto savedInvalidate = s_invalidate;
+  s_painter = nullptr;
+  s_invalidate = nullptr;
+  s_numberOfBuiltin = 0;
+  for (int a = 0; a < k_numberOfArts; a++) {
+    s_builtin[s_numberOfBuiltin] = s_numberOfBuiltin + 1;
+    s_builtinArt[s_numberOfBuiltin] = a;
+    s_builtinLabel[s_numberOfBuiltin] = k_builtinArt[a].label;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = 2;
+  State saved = s;
+
+  // Still pictures
+  fresh();
+  s.intro = k_introFrames;
+  wait(36);
+  shoot("intro");
+  s.intro = 0;
+  s.profile = true;
+  wait(4);
+  shoot("profil");
+  key(Events::OK, 24);
+  shoot("accueil");
+  key(Events::Right, 6);
+  key(Events::Right, 6);
+  key(Events::Right, 12);
+  shoot("selection");
+  key(Events::Down, 2);
+  key(Events::Down, 2);
+  key(Events::Right, 6);
+  shoot("decouvrir");
+  key(Events::Back, 2);
+  key(Events::Up, 4);
+  shoot("barre");
+  key(Events::Left, 2);
+  key(Events::Left, 2);
+  key(Events::OK, 20);
+  shoot("jeux");
+  key(Events::Toolbox, 20);
+  s.theme = 1;
+  s_ribbonFor = -2;
+  prepareBackground();
+  key(Events::Right, 14);
+  shoot("nebuleuse");
+  s.theme = 3;
+  s_ribbonFor = -2;
+  prepareBackground();
+  key(Events::Right, 14);
+  shoot("braise");
+  s.theme = 0;
+  s_ribbonFor = -2;
+  prepareBackground();
+  key(Events::Up, 2);
+  key(Events::Right, 2);
+  key(Events::Right, 2);
+  key(Events::Right, 2);
+  key(Events::OK, 10);
+  shoot("profil_panneau");
+
+  // GIF 1: boot, profile, moving around, opening an app
+  fresh();
+  s.intro = k_introFrames;
+  s.profile = true;
+  wait(k_introFrames + 14, "gifaccueil");
+  key(Events::OK, 20, "gifaccueil");
+  Event path[] = {Events::Right, Events::Right, Events::Right,
+                  Events::Right, Events::Left,  Events::Down,
+                  Events::Down,  Events::Right, Events::Up,
+                  Events::Up};
+  for (Event e : path) {
+    key(e, 8, "gifaccueil");
+  }
+  zoomShots("gifaccueil");
+
+  // GIF 2: themes and tabs
+  fresh();
+  s.sel[TabApps] = 3;
+  s.scroll = 3;
+  wait(10, "gifthemes");
+  for (int th = 1; th < k_numberOfThemes; th++) {
+    s.theme = th;
+    s.toast = k_toastFrames;
+    prepareBackground();
+    wait(10, "gifthemes");
+  }
+  s.theme = 0;
+  prepareBackground();
+  key(Events::Toolbox, 18, "gifthemes");
+  key(Events::Right, 10, "gifthemes");
+  key(Events::Toolbox, 18, "gifthemes");
+
+  s = saved;
+  s_photo = false;
+  s_painter = savedPainter;
+  s_invalidate = savedInvalidate;
+  if (getenv("DS_SHOTS_EXIT")) {
+    exit(0);
+  }
+}
+
+#endif
+
+}  // namespace Shell
+
+}  // namespace Ds
+}  // namespace Home
